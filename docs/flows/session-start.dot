digraph session_start {
  graph [
    label="Arranque: desde Exec= hasta el escritorio",
    labelloc=t,
    fontsize=24,
    fontname="DejaVu Sans Bold",
    bgcolor="#f8fafc",
    pad=0.25,
    nodesep=0.42,
    ranksep=0.55,
    splines=polyline
  ];
  node [shape=box, style="rounded,filled", fontname="DejaVu Sans", fontsize=11,
        color="#2563eb", fillcolor="#eff6ff", fontcolor="#0f172a", margin="0.15,0.10"];
  edge [fontname="DejaVu Sans", fontsize=9, color="#64748b", fontcolor="#334155", arrowsize=0.75];

  caller [shape=oval, fillcolor="#dbeafe",
          label="El display manager ejecuta Exec=\n(o se invoca uxsm desde un terminal)"];
  start [label="uxsm start recibe qué sesión debe abrir"];
  kind [shape=diamond, label="¿Ha recibido el ID de una entrada .desktop\no un comando para ejecutar directamente?"];

  entry [label="Entrada: uxsm start bspwm.desktop\n\nBusca la entrada original en los directorios XDG\ny obtiene Exec= y DesktopNames="];
  command [label="Comando: uxsm start -D bspwm -- bspwm\n\nComprueba que el programa existe\ny conserva el comando completo"];
  resolved [shape=note, color="#64748b", fillcolor="#f1f5f9",
            label="Resultado común\nID de la sesión · comando · nombres del escritorio"];

  identity [label="Construye la identidad que recibirá el escritorio\nXDG_CURRENT_DESKTOP · XDG_SESSION_DESKTOP\nXDG_MENU_PREFIX · XDG_SESSION_TYPE=x11"];
  wait [label="Espera a que termine cualquier\nsesión anterior que aún se apaga"];
  files [shape=folder, fillcolor="#fef3c7", color="#ca8a04",
         label="$XDG_RUNTIME_DIR/uxsm\nenv_login\nenv_identity\ncommand (sólo comando directo)"];

  bind [label="systemd vigila el proceso del login\nuxsm-bindpid@PID.service\n\nSi el display manager lo mata, cierra la sesión"];
  replace [label="uxsm se sustituye por systemctl --wait\ny espera a uxsm-desktop@ID.service\n\nAsí el proceso que vigila el login no cambia"];

  env [fillcolor="#ede9fe", color="#7c3aed",
       label="Antes del escritorio\nuxsm-env@ID.service prepara\nel entorno de systemd --user"];
  aux [fillcolor="#dcfce7", color="#15803d", fontcolor="#14532d",
       label="systemd arranca uxsm-desktop@ID.service\nLa plantilla sólo contiene el ID, no el comando"];
  source [shape=diamond, fillcolor="#f0fdf4", color="#15803d",
          label="¿ID termina en .desktop?"];
  reread [fillcolor="#dcfce7", color="#15803d", fontcolor="#14532d",
          label="Vuelve a abrir la entrada original\ny toma su Exec="];
  saved [fillcolor="#dcfce7", color="#15803d", fontcolor="#14532d",
         label="Lee el comando guardado\nen el directorio de runtime"];
  desktop [shape=oval, fillcolor="#bbf7d0", color="#15803d", fontcolor="#14532d",
           label="exec sustituye el auxiliar por el escritorio\n\nEl propio bspwm (u otro escritorio) queda como\nproceso principal del servicio de systemd"];
  waitwm [fillcolor="#dcfce7", color="#15803d", fontcolor="#14532d",
          label="ExecStartPost= ejecuta uxsm aux wait-ready\n\nEspera a lo que llegue antes: la marca EWMH del gestor\nde ventanas en el servidor X, o un uxsm finalize del escritorio"];
  ready [shape=oval, fillcolor="#bbf7d0", color="#15803d", fontcolor="#14532d",
         label="El servicio cuenta como arrancado\n\nDetrás van uxsm-session@ID.target\ny graphical-session.target"];
  nowm [shape=oval, color="#b91c1c", fillcolor="#fee2e2", fontcolor="#7f1d1d",
        label="Sin ninguna de las dos, TimeoutStartSec=\nhace fallar el servicio y cierra la sesión"];

  caller -> start -> kind;
  kind -> entry [label=" ID .desktop "];
  kind -> command [label=" comando "];
  entry -> resolved;
  command -> resolved;
  resolved -> identity -> wait -> files;
  files -> bind;
  files -> replace;
  replace -> env [label=" Requires + After "];
  env -> aux;
  aux -> source;
  source -> reread [label=" sí "];
  source -> saved [label=" no "];
  reread -> desktop;
  saved -> desktop;
  desktop -> waitwm;
  waitwm -> ready [label=" una de las dos enciende la señal "];
  waitwm -> nowm [label=" se agota la espera ", color="#b91c1c", fontcolor="#7f1d1d"];

  {rank=same; entry; command}
  {rank=same; bind; replace}
  {rank=same; reread; saved}
  {rank=same; ready; nowm}
}
