digraph systemd_lifecycle {
  graph [
    label="systemd unit graph and convergent shutdown",
    labelloc=t,
    fontsize=24,
    fontname="DejaVu Sans Bold",
    bgcolor="#f8fafc",
    pad=0.30,
    nodesep=0.50,
    ranksep=0.66,
    splines=polyline,
    newrank=true
  ];
  node [shape=box, style="rounded,filled", fontname="DejaVu Sans", fontsize=11,
        color="#2563eb", fillcolor="#eff6ff", fontcolor="#0f172a", margin="0.16,0.11"];
  edge [fontname="DejaVu Sans", fontsize=9, color="#475569", fontcolor="#334155", arrowsize=0.75];

  login [shape=oval, fillcolor="#dbeafe",
         label="Display manager's session process\nexecs systemctl --user start --wait"];

  subgraph cluster_active {
    label="Active session";
    color="#93c5fd";
    style="rounded,filled";
    fillcolor="#ffffff";
    fontname="DejaVu Sans Bold";

    bind [label="uxsm-bindpid@PID.service\n\nWatches the display manager's\nsession-process PID"];
    env [fillcolor="#ede9fe", color="#7c3aed",
         label="uxsm-env@ID.service\n\nPrepares the environment first\nand restores it when stopped"];
    desktop [fillcolor="#dcfce7", color="#15803d", fontcolor="#14532d",
             label="uxsm-desktop@ID.service\n\nRuns the desktop as its main process\nWaits for readiness"];
    session [shape=folder,
             label="uxsm-session@ID.target\n\nRepresents this uxsm session"];
    graphical [shape=folder, fillcolor="#ede9fe", color="#7c3aed",
               label="Standard graphical targets\ngraphical-session-pre.target\ngraphical-session.target"];
    autostart [shape=folder, fillcolor="#fef3c7", color="#ca8a04",
               label="uxsm-autostart@ID.target\n\nPulls in xdg-desktop-autostart.target\nwhen uxsm owns autostart"];
    apps [shape=folder, fillcolor="#fef3c7", color="#ca8a04",
          label="Session application slices\napp-uxsm.slice · background-uxsm.slice\nsession-uxsm.slice"];

    desktop -> env [label=" Requires + After "];
    desktop -> session [label=" BindsTo "];
    session -> graphical [label=" BindsTo "];
    desktop -> autostart [label=" ExecStartPost "];
    apps -> graphical [label=" PartOf "];
    env -> graphical [label=" graphical-session-pre "];
  }

  subgraph cluster_shutdown {
    label="Every exit path reaches the same shutdown target";
    color="#fca5a5";
    style="rounded,filled";
    fillcolor="#ffffff";
    fontname="DejaVu Sans Bold";

    quit [shape=oval, color="#b91c1c", fillcolor="#fee2e2", fontcolor="#7f1d1d",
          label="Desktop exits, fails,\nor never becomes ready"];
    killed [shape=oval, color="#b91c1c", fillcolor="#fee2e2", fontcolor="#7f1d1d",
            label="Display manager's\nsession process disappears"];
    stop [shape=oval, color="#b91c1c", fillcolor="#fee2e2", fontcolor="#7f1d1d",
          label="User runs\nuxsm stop"];
    shutdown [shape=octagon, color="#b91c1c", fillcolor="#fecaca", fontcolor="#7f1d1d",
              label="uxsm-shutdown.target\nSingle shutdown coordinator"];
    stopunits [label="Conflicts= stops the desktop, environment,\nautostart, applications, and graphical targets"];
    cleanup [fillcolor="#fef3c7", color="#ca8a04",
             label="uxsm-env@ ExecStopPost=\nrestores the previous environment\nand removes runtime files"];
    down [shape=oval, fillcolor="#e2e8f0", color="#64748b",
          label="No uxsm session process\nor runtime state remains"];

    quit -> shutdown [label=" OnSuccess / OnFailure ", color="#b91c1c"];
    killed -> shutdown [label=" OnSuccess / OnFailure ", color="#b91c1c"];
    stop -> shutdown [color="#b91c1c"];
    shutdown -> stopunits -> cleanup -> down;
    {rank=same; quit; killed; stop}
  }

  login -> bind [label=" start watcher "];
  login -> desktop [label=" start and wait "];
  desktop -> quit [style=dashed, arrowhead=none];
  bind -> killed [style=dashed, arrowhead=none];
}
