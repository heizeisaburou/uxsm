[Unit]
Description=User Graphical Session Application Slice of uxsm
Documentation=https://github.com/heizeisaburou/uxsm
# This makes applications stop with the session. A dash denotes hierarchy in
# systemd, so this slice is a child of the standard session.slice.
PartOf=graphical-session.target
After=graphical-session.target
Conflicts=uxsm-shutdown.target
Before=uxsm-shutdown.target
