digraph session_start {
  graph [
    label="Session startup: from the display manager to a ready desktop",
    labelloc=t,
    fontsize=24,
    fontname="DejaVu Sans Bold",
    bgcolor="#f8fafc",
    pad=0.28,
    nodesep=0.45,
    ranksep=0.60,
    splines=polyline,
    newrank=true
  ];
  node [shape=box, style="rounded,filled", fontname="DejaVu Sans", fontsize=11,
        color="#2563eb", fillcolor="#eff6ff", fontcolor="#0f172a", margin="0.16,0.11"];
  edge [fontname="DejaVu Sans", fontsize=9, color="#64748b", fontcolor="#334155", arrowsize=0.75];

  caller [shape=oval, fillcolor="#dbeafe",
          label="The display manager runs Exec=\n(or uxsm is started from a terminal)"];

  subgraph cluster_resolve {
    label="1 · Resolve and record the session";
    color="#93c5fd";
    style="rounded,filled";
    fillcolor="#ffffff";
    fontname="DejaVu Sans Bold";

    start [label="uxsm start"];
    kind [shape=diamond, label="Session entry ID\nor direct command?"];
    entry [label="uxsm start bspwm.desktop\n\nFind the entry through XDG lookup\nRead Exec= and DesktopNames="];
    command [label="uxsm start -D bspwm -- bspwm\n\nValidate the executable\nKeep the full argument vector"];
    identity [label="Build the XDG identity\nXDG_CURRENT_DESKTOP\nXDG_SESSION_DESKTOP\nXDG_MENU_PREFIX · XDG_SESSION_TYPE=x11"];
    wait [label="Wait until any previous\nuxsm or uwsm session is fully stopped"];
    files [shape=folder, fillcolor="#fef3c7", color="#ca8a04",
           label="$XDG_RUNTIME_DIR/uxsm\nenv_login · env_identity\ncommand (direct command only)"];

    start -> kind;
    kind -> entry [label=" entry "];
    kind -> command [label=" command "];
    entry -> identity;
    command -> identity;
    identity -> wait -> files;
    {rank=same; entry; command}
  }

  subgraph cluster_systemd {
    label="2 · Hand ownership to systemd --user";
    color="#c4b5fd";
    style="rounded,filled";
    fillcolor="#ffffff";
    fontname="DejaVu Sans Bold";

    bind [label="uxsm-bindpid@PID.service\nwatches the display manager's process\nand triggers shutdown if it disappears"];
    replace [label="uxsm execs systemctl --user start --wait\nuxsm-desktop@ID.service\n\nThe display manager keeps watching the same PID"];
    env [fillcolor="#ede9fe", color="#7c3aed",
         label="uxsm-env@ID.service\nprepares the user-manager environment"];
    desktop_service [fillcolor="#dcfce7", color="#15803d", fontcolor="#14532d",
                     label="uxsm-desktop@ID.service\nruns uxsm aux exec ID"];
    source [shape=diamond, fillcolor="#f0fdf4", color="#15803d",
            label="Does ID end\nin .desktop?"];
    reread [fillcolor="#dcfce7", color="#15803d", fontcolor="#14532d",
            label="Reopen the entry\nand read Exec="];
    saved [fillcolor="#dcfce7", color="#15803d", fontcolor="#14532d",
           label="Read the saved\nargument vector"];
    desktop [shape=oval, fillcolor="#bbf7d0", color="#15803d", fontcolor="#14532d",
             label="exec replaces the helper with the desktop\nThe desktop is now the service's main process"];

    replace -> env [label=" Requires + After "];
    env -> desktop_service -> source;
    source -> reread [label=" yes "];
    source -> saved [label=" no "];
    reread -> desktop;
    saved -> desktop;
    {rank=same; bind; replace}
    {rank=same; reread; saved}
  }

  subgraph cluster_ready {
    label="3 · Gate the graphical session on readiness";
    color="#86efac";
    style="rounded,filled";
    fillcolor="#ffffff";
    fontname="DejaVu Sans Bold";

    waitwm [label="ExecStartPost=uxsm aux wait-ready\n\nWait for a valid EWMH window-manager marker\nor an explicit uxsm finalize"];
    ready [shape=oval, fillcolor="#bbf7d0", color="#15803d", fontcolor="#14532d",
           label="Ready\nuxsm-session@ID.target and\ngraphical-session.target may start"];
    timeout [shape=oval, color="#b91c1c", fillcolor="#fee2e2", fontcolor="#7f1d1d",
             label="30-second timeout\nThe service fails and the session shuts down"];

    waitwm -> ready [label=" signal arrives "];
    waitwm -> timeout [label=" timeout ", color="#b91c1c", fontcolor="#7f1d1d"];
    {rank=same; ready; timeout}
  }

  caller -> start;
  files -> bind;
  files -> replace;
  desktop -> waitwm;
}
