digraph systemd_lifecycle {
  graph [
    label="Qué mantiene systemd durante la sesión y cómo la cierra",
    labelloc=t,
    fontsize=24,
    fontname="DejaVu Sans Bold",
    bgcolor="#f8fafc",
    pad=0.30,
    nodesep=0.52,
    ranksep=0.68,
    splines=polyline
  ];
  node [shape=box, style="rounded,filled", fontname="DejaVu Sans", fontsize=11,
        color="#2563eb", fillcolor="#eff6ff", fontcolor="#0f172a", margin="0.16,0.11"];
  edge [fontname="DejaVu Sans", fontsize=9, color="#475569", fontcolor="#334155", arrowsize=0.75];

  login [shape=oval, fillcolor="#dbeafe",
         label="Proceso de sesión del display manager\nAhora ejecuta systemctl --user start --wait"];

  subgraph cluster_active {
    label="Mientras la sesión está activa";
    color="#93c5fd";
    style="rounded,filled";
    fillcolor="#ffffff";
    fontname="DejaVu Sans Bold";

    bind [label="uxsm-bindpid@PID.service\n\nVigila el PID del proceso de sesión"];
    env [fillcolor="#ede9fe", color="#7c3aed",
         label="uxsm-env@ID.service\n\nPrepara el entorno antes de arrancar\ny lo restaura cuando se detiene"];
    desktop [fillcolor="#dcfce7", color="#15803d", fontcolor="#14532d",
             label="uxsm-desktop@ID.service\n\nSu proceso principal es el escritorio"];
    session [shape=folder,
             label="uxsm-session@ID.target\n\nAgrupa todo lo que pertenece\na esta sesión de uxsm"];
    standards [shape=folder, fillcolor="#ede9fe", color="#7c3aed",
               label="Targets estándar de systemd\n\ngraphical-session-pre.target\ngraphical-session.target"];

    desktop -> env [label=" Requires + After\nprimero el entorno "];
    desktop -> session [label=" BindsTo\nmisma vida "];
    session -> standards [label=" activa la sesión gráfica "];
    env -> standards [label=" activa la fase previa "];
  }

  subgraph cluster_shutdown {
    label="Cualquier forma de salir converge en el mismo cierre";
    color="#fca5a5";
    style="rounded,filled";
    fillcolor="#ffffff";
    fontname="DejaVu Sans Bold";

    quit [shape=oval, color="#b91c1c", fillcolor="#fee2e2", fontcolor="#7f1d1d",
          label="El escritorio termina\no falla"];
    killed [shape=oval, color="#b91c1c", fillcolor="#fee2e2", fontcolor="#7f1d1d",
            label="Desaparece el proceso\ndel display manager"];
    stop [shape=oval, color="#b91c1c", fillcolor="#fee2e2", fontcolor="#7f1d1d",
          label="El usuario ejecuta\nuxsm stop"];
    shutdown [shape=octagon, color="#b91c1c", fillcolor="#fecaca", fontcolor="#7f1d1d",
              label="uxsm-shutdown.target\nPunto único de cierre"];
    stopunits [label="Por Conflicts=, systemd detiene\nel escritorio, el entorno y los targets\nde la sesión gráfica"];
    cleanup [fillcolor="#fef3c7", color="#ca8a04",
             label="Al parar uxsm-env@, ExecStopPost=\nrestaura el entorno anterior y borra\nlos ficheros temporales de la sesión"];
    down [shape=oval, fillcolor="#e2e8f0", color="#64748b",
          label="No queda ningún proceso ni estado\nperteneciente a la sesión"];

    quit -> shutdown [label=" OnSuccess / OnFailure ", color="#b91c1c"];
    killed -> shutdown [label=" OnSuccess / OnFailure ", color="#b91c1c"];
    stop -> shutdown [color="#b91c1c"];
    shutdown -> stopunits -> cleanup -> down;

    {rank=same; quit; killed; stop}
  }

  login -> bind [label=" arranca el vigilante "];
  login -> desktop [label=" arranca y espera "];
  desktop -> quit [style=dashed, arrowhead=none];
  bind -> killed [style=dashed, arrowhead=none];
}
