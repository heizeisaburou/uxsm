[Unit]
Description=uxsm: XDG autostart of %i
Documentation=https://github.com/heizeisaburou/uxsm
# No unit pulls in this target: `uxsm aux autostart` starts it from the desktop's
# ExecStartPost=, and only in sessions where uxsm owns autostart. Starting it
# pulls in systemd's standard target, which cannot be started manually
# (RefuseManualStart=).
PartOf=graphical-session.target
After=uxsm-session@%i.target graphical-session.target
BindsTo=xdg-desktop-autostart.target
Before=xdg-desktop-autostart.target
PropagatesStopTo=xdg-desktop-autostart.target
Conflicts=uxsm-shutdown.target
Before=uxsm-shutdown.target
CollectMode=inactive-or-failed
# No StopWhenUnneeded=: nothing pulls in this target because uxsm starts it, so
# systemd would stop it immediately as unneeded. It is stopped by the graphical
# session's PartOf= and the shutdown target's Conflicts=.
