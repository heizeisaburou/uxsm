digraph environment {
  graph [
    label="Session environment: prepare, share, and restore",
    labelloc=t,
    fontsize=24,
    fontname="DejaVu Sans Bold",
    bgcolor="#f8fafc",
    pad=0.28,
    nodesep=0.52,
    ranksep=0.62,
    splines=polyline,
    newrank=true
  ];
  node [shape=box, style="rounded,filled", fontname="DejaVu Sans", fontsize=11,
        color="#2563eb", fillcolor="#eff6ff", fontcolor="#0f172a", margin="0.16,0.11"];
  edge [fontname="DejaVu Sans", fontsize=9, color="#64748b", fontcolor="#334155", arrowsize=0.75];

  subgraph cluster_inputs {
    label="Inputs";
    color="#fde68a";
    style="rounded,filled";
    fillcolor="#ffffff";
    fontname="DejaVu Sans Bold";

    manager [shape=cylinder, fillcolor="#ede9fe", color="#7c3aed",
             label="Current environment of\nsystemd --user"];
    login [shape=folder, fillcolor="#fef3c7", color="#ca8a04",
           label="env_login\nEnvironment received from\nthe display manager"];
    identity [shape=folder, fillcolor="#fef3c7", color="#ca8a04",
              label="env_identity\nComputed XDG variables"];
    config [shape=folder, fillcolor="#fef3c7", color="#ca8a04",
            label="Profile and uxsm environment files\n/etc/profile · ~/.profile\nuxsm/env · uxsm/env-<desktop> · .d"];
  }

  subgraph cluster_prepare {
    label="Startup · uxsm-env@ prepares one shared session environment";
    color="#93c5fd";
    style="rounded,filled";
    fillcolor="#ffffff";
    fontname="DejaVu Sans Bold";

    snapshot [shape=folder, fillcolor="#fef3c7", color="#ca8a04",
              label="env_pre\nFiltered snapshot used for restoration"];
    merge [label="Overlay the login environment\non the manager snapshot"];
    loader [label="Run the embedded /bin/sh loader\nand apply XDG identity + config files"];
    diff [label="Compare the result with the current manager\nCompute variables to set and unset"];
    marked [shape=folder, fillcolor="#fef3c7", color="#ca8a04",
            label="env_cleanup\nNames owned by this session"];
    apply [fillcolor="#dcfce7", color="#15803d", fontcolor="#14532d",
           label="Update systemd --user"];
    dbus [fillcolor="#dcfce7", color="#15803d", fontcolor="#14532d",
          label="With dbus-daemon only\nUpdateActivationEnvironment\n(dbus-broker already delegates to systemd)"];
    processes [shape=oval, fillcolor="#bbf7d0", color="#15803d", fontcolor="#14532d",
               label="Desktop and activated services\ninherit the prepared environment"];

    merge -> loader -> diff;
    diff -> marked;
    diff -> apply;
    apply -> dbus;
    apply -> processes;
  }

  subgraph cluster_cleanup {
    label="Shutdown · restore exactly what existed before the session";
    color="#fca5a5";
    style="rounded,filled";
    fillcolor="#ffffff";
    fontname="DejaVu Sans Bold";

    stop [shape=oval, fillcolor="#fee2e2", color="#b91c1c", fontcolor="#7f1d1d",
          label="systemd stops uxsm-env@"];
    compare [label="Compare env_pre, env_cleanup,\nand the current environment"];
    unset [label="Remove variables created\nfor the session"];
    restore [label="Restore every value\nrecorded in env_pre"];
    remove [shape=folder, fillcolor="#e2e8f0", color="#64748b",
            label="Remove uxsm runtime files\nenv_pre · env_cleanup · env_login\nenv_identity · command"];

    stop -> compare -> unset -> restore -> remove;
  }

  manager -> snapshot;
  manager -> merge;
  login -> merge;
  identity -> loader;
  config -> loader;
  processes -> stop [label=" session ends ", color="#b91c1c"];
  snapshot -> compare [style=dashed];
  marked -> compare [style=dashed];
}
