[Unit]
Description=uxsm: X11 desktop of %i
Documentation=https://github.com/heizeisaburou/uxsm
Requires=uxsm-env@%i.service
After=uxsm-env@%i.service graphical-session-pre.target
BindsTo=uxsm-session@%i.target
Before=uxsm-session@%i.target graphical-session.target
PropagatesStopTo=uxsm-session@%i.target graphical-session.target
OnSuccess=uxsm-shutdown.target
OnSuccessJobMode=replace-irreversibly
OnFailure=uxsm-shutdown.target
OnFailureJobMode=replace-irreversibly
Conflicts=uxsm-shutdown.target
Before=uxsm-shutdown.target
CollectMode=inactive-or-failed

[Service]
Type=exec
ExecStart=@BINDIR@/uxsm aux exec %i
# Hasta que la sesión está lista ―hay gestor de ventanas, o el escritorio ha
# ejecutado uxsm finalize―, el servicio no cuenta como arrancado y la sesión no
# sigue. Si no llega a estarlo, el servicio falla al agotarse TimeoutStartSec= y
# OnFailure= apaga la sesión.
ExecStartPost=@BINDIR@/uxsm aux wait-ready
# Y con el escritorio ya en pantalla, el autostart XDG, si le toca a uxsm. El "-"
# es a propósito: una sesión no se cae porque falle el autostart.
ExecStartPost=-@BINDIR@/uxsm aux autostart %i
TimeoutStartSec=30
Restart=no
Slice=session.slice
