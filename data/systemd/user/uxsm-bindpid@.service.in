[Unit]
Description=uxsm: bind the X11 session to PID %i
Documentation=https://github.com/heizeisaburou/uxsm
OnSuccess=uxsm-shutdown.target
OnSuccessJobMode=replace-irreversibly
OnFailure=uxsm-shutdown.target
OnFailureJobMode=replace-irreversibly
Conflicts=uxsm-shutdown.target
Before=uxsm-shutdown.target
CollectMode=inactive-or-failed

[Service]
Type=exec
ExecStart=@BINDIR@/uxsm aux waitpid %i
Restart=no
Slice=background.slice
