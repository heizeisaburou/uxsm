digraph build_tests {
  graph [
    label="Compilación, pruebas y release",
    labelloc=t,
    fontsize=24,
    fontname="DejaVu Sans Bold",
    bgcolor="#f8fafc",
    pad=0.28,
    nodesep=0.48,
    ranksep=0.62,
    splines=polyline
  ];
  node [shape=box, style="rounded,filled", fontname="DejaVu Sans", fontsize=11,
        color="#2563eb", fillcolor="#eff6ff", fontcolor="#0f172a", margin="0.15,0.10"];
  edge [fontname="DejaVu Sans", fontsize=9, color="#64748b", fontcolor="#334155", arrowsize=0.75];

  source [shape=folder, fillcolor="#dbeafe", label="Árbol de trabajo"];

  subgraph cluster_local {
    label="Comprobaciones rápidas locales";
    color="#93c5fd";
    style="rounded,filled";
    fillcolor="#ffffff";
    fontname="DejaVu Sans Bold";

    build [label="make build"];
    vet [label="go vet ./..."];
    gobuild [fillcolor="#dcfce7", color="#15803d", fontcolor="#14532d",
             label="go build\n→ bin/uxsm"];
    test [label="make test\ngo test ./..."];
    units [fillcolor="#dcfce7", color="#15803d", fontcolor="#14532d",
           label="Pruebas unitarias\nCLI y resolución de targets\n.desktop y Exec=\ndisplay managers\nidentidad y runtime\nentorno\ngeneración de entradas\nsystemd y pidfd"];
    hook [shape=note, fillcolor="#fef3c7", color="#ca8a04",
          label="pre-commit\ngofmt + vet + unitarias\n+ sh -n de scripts"];

    build -> vet -> gobuild;
    test -> units;
    hook -> vet [style=dashed];
    hook -> test [style=dashed];
  }

  subgraph cluster_vm {
    label="Paquetes y pruebas reales en máquinas desechables";
    color="#c4b5fd";
    style="rounded,filled";
    fillcolor="#ffffff";
    fontname="DejaVu Sans Bold";

    testvm [label="make test-vm\ntest/release.sh DISTROS"];
    version [label="test/version.sh\nVersión desde git"];
    tarball [shape=folder, label="Tarball reproducible\ndel árbol actual"];
    buildvm [label="VM de compilación por distro\nArch · Debian · Ubuntu\nFedora · openSUSE"];
    package [shape=folder, fillcolor="#ede9fe", color="#7c3aed",
             label="Paquete nativo\n.pkg.tar.zst · .deb · .rpm"];
    testvmclean [label="Otra VM limpia por distro\nInstala el paquete con su gestor"];
    integration [fillcolor="#dcfce7", color="#15803d", fontcolor="#14532d",
                 label="Pruebas de integración sobre Xvfb\n01 servicio y comando directo\n02 cierre por tres caminos\n03 identidad\n04 entorno y restauración\n05 entradas/check/setup"];
    checksums [shape=folder, fillcolor="#fef3c7", color="#ca8a04",
               label="build/release/<distro>\n+ SHA256SUMS"];

    testvm -> version -> tarball -> buildvm -> package -> testvmclean -> integration -> checksums;
  }

  release [shape=oval, fillcolor="#dbeafe", color="#2563eb",
           label="make release\nEquivale a release.sh --publish"];
  latest [shape=folder, fillcolor="#bbf7d0", color="#15803d", fontcolor="#14532d",
          label="releases/latest\nJuego completo ya probado"];
  push [shape=note, fillcolor="#fef3c7", color="#ca8a04",
        label="pre-push a main/master o vX.Y.Z\nExige un make release del mismo commit"];

  source -> build;
  source -> test;
  source -> testvm;
  source -> release;
  release -> testvm [label=" todas + publicar "];
  checksums -> latest [label=" con --publish "];
  push -> release [style=dashed];
}
