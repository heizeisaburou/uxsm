#!/bin/sh
# Antes de subir a producción ―la rama main o master, o una etiqueta vX.Y.Z―,
# lo que se sube tiene que haber pasado `make release`: compilar los paquetes y
# probarlos instalados en todas las distribuciones. Las demás ramas suben sin más.
#
# releases/latest/version dice de qué se compiló, así que si ya se hizo con
# este mismo commit no se repite. Si no, se ejecuta ahora y el push espera.
# `git push --no-verify` se lo salta.

set -eu
cd "$(git rev-parse --show-toplevel)"

zero=0000000000000000000000000000000000000000
gated=

# Una línea por referencia: <ref local> <sha local> <ref remota> <sha remota>.
while read -r _ local_sha remote_ref _; do
    [ "$local_sha" != "$zero" ] || continue # borrar una referencia
    case "$remote_ref" in
    refs/heads/main | refs/heads/master | refs/tags/v[0-9]*) ;;
    *) continue ;;
    esac
    # Una etiqueta anotada llega como su propio objeto, no como el commit.
    commit=$(git rev-parse "$local_sha^{commit}")
    if [ "$commit" != "$(git rev-parse HEAD)" ]; then
        echo "pre-push: $remote_ref is not HEAD; check it out so make release can build it" >&2
        exit 1
    fi
    gated=1
done

[ -n "$gated" ] || exit 0

version=$(test/version.sh)
case "$version" in
*.dirty)
    echo "pre-push: the working tree has changes; commit or stash them first" >&2
    exit 1
    ;;
esac

if [ "$(cat releases/latest/version 2>/dev/null)" = "$version" ]; then
    echo "pre-push: releases/latest is uxsm $version, already tested" >&2
    exit 0
fi

echo "pre-push: releases/latest is not uxsm $version; running make release" >&2
# stdin es la lista de referencias, no un terminal.
make release </dev/null
