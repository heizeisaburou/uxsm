digraph session_entries {
  graph [
    label="Entradas .desktop: qué se genera y qué ocurre al elegirlas",
    labelloc=t,
    fontsize=24,
    fontname="DejaVu Sans Bold",
    bgcolor="#f8fafc",
    pad=0.28,
    nodesep=0.45,
    ranksep=0.58,
    splines=polyline
  ];
  node [shape=box, style="rounded,filled", fontname="DejaVu Sans", fontsize=11,
        color="#2563eb", fillcolor="#eff6ff", fontcolor="#0f172a", margin="0.15,0.10"];
  edge [fontname="DejaVu Sans", fontsize=9, color="#64748b", fontcolor="#334155", arrowsize=0.75];

  cli [shape=oval, fillcolor="#dbeafe",
       label="uxsm entry crea una entrada que verá el display manager"];
  mode [shape=diamond, label="¿Qué tipo se pide?"];

  ref [label="Normal: uxsm entry bspwm\nParte de bspwm.desktop ya instalada"];
  direct [label="Directa: uxsm entry --exec bspwm\nObtiene el comando de una entrada,\nla base interna o lo escrito tras --"];
  plain [label="Sin uxsm: uxsm entry --plain bspwm\nObtiene el comando de la base interna\no de lo escrito tras --"];

  validate [label="Valida los datos y evita recursión o dobles gestores\n\nRechaza algo que ya usa uxsm, sesiones que ya\narrancan con systemd y metasesiones como xinit-compat"];
  names [label="Completa nombre, comentario y DesktopNames\ncon la entrada original o la base de datos interna\nLas opciones -D y -e permiten ajustarlos"];
  ownautostart [shape=note, color="#64748b", fillcolor="#f1f5f9",
                label="Si la base de datos dice que ese escritorio\nlanza su propio autostart XDG (Xfce, GNOME, Plasma…),\nel Exec= lleva además --no-autostart"];

  out_ref [shape=note, fillcolor="#dcfce7", color="#15803d", fontcolor="#14532d",
           label="bspwm-uxsm.desktop\nExec=uxsm start bspwm.desktop\n\nAl elegirla:\ndisplay manager → uxsm → entrada original → bspwm"];
  out_direct [shape=note, fillcolor="#dcfce7", color="#15803d", fontcolor="#14532d",
              label="bspwm-uxsm.desktop\nExec=uxsm start -D bspwm -- bspwm\n\nAl elegirla:\ndisplay manager → uxsm → bspwm\nNo vuelve a necesitar la entrada original"];
  out_plain [shape=note, fillcolor="#dcfce7", color="#15803d", fontcolor="#14532d",
             label="bspwm.desktop\nExec=bspwm\n\nAl elegirla:\ndisplay manager → bspwm\nuxsm no interviene"];

  destination [label="Comprueba el destino\nSi ya existe o taparía otra entrada,\nsin -f se rechaza"];
  preview [label="Sin -i\nEnseña la ruta y el contenido\nsin escribir nada"];
  write [shape=folder, fillcolor="#fef3c7", color="#ca8a04",
         label="Con -i\n/usr/local/share/xsessions/\n(necesita permisos de root)"];
  dm [shape=diamond, label="¿El display manager lee\n/usr/local/share/xsessions?"];
  visible [shape=oval, fillcolor="#bbf7d0", color="#15803d", fontcolor="#14532d",
           label="La sesión aparece\nen la pantalla de login"];
  tools [fillcolor="#fff7ed", color="#ea580c", fontcolor="#7c2d12",
         label="uxsm check informa\nuxsm setup xsessions-dir propone/aplica\nel cambio para LightDM o SDDM\n(GDM sólo explica el cambio)"];

  cli -> mode;
  mode -> ref [label=" normal "];
  mode -> direct [label=" --exec "];
  mode -> plain [label=" --plain "];
  ref -> validate;
  direct -> validate;
  plain -> validate;
  validate -> names;
  names -> ownautostart [style=dashed, arrowhead=none];
  names -> out_ref [label=" normal "];
  names -> out_direct [label=" --exec "];
  names -> out_plain [label=" --plain "];
  out_ref -> destination;
  out_direct -> destination;
  out_plain -> destination;
  destination -> preview [label=" sin -i "];
  destination -> write [label=" -i "];
  write -> dm;
  dm -> visible [label=" sí "];
  dm -> tools [label=" no "];
  tools -> visible [label=" tras configurarlo "];

  {rank=same; ref; direct; plain}
  {rank=same; out_ref; out_direct; out_plain}
  {rank=same; preview; write}
}
